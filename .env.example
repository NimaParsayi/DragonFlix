# کپی کن به .env و پر کن:  cp .env.example .env

# دامنه‌ای که A-record آن به IP سرور اشاره می‌کند (بدون https://)
DOMAIN=flix.example.com

# توکن ربات از BotFather
BOT_TOKEN=

# یک رشتهٔ تصادفی بلند (حداقل ۳۲ کاراکتر):  openssl rand -base64 48
JWT_KEY=

# کلید TMDB (اختیاری)
TMDB_API_KEY=

# اگر سرور مستقیم به api.telegram.org دسترسی ندارد، آدرس پروکسی/آینه (اختیاری)
# TELEGRAM_API_BASE=https://tg-proxy.example.com

# منطقهٔ زمانی سرور
TZ=Asia/Tehran

# --- فقط برای CI/CD و کشیدن ایمیج از GHCR (نام کاربری/سازمان گیت‌هاب، حروف کوچک) ---
GHCR_OWNER=
TAG=latest
