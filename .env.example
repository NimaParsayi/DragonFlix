# کپی کن به .env و پر کن:  cp .env.example .env

# دامنه‌ای که A-record آن به IP سرور اشاره می‌کند (بدون https://)
DOMAIN=flix.example.com

# --- پورت‌های سرور (پیش‌فرض ۸۰ و ۴۴۳) ---
# فقط وقتی عوض کن که این پورت‌ها اشغال‌اند. دقت: گرفتن گواهی HTTPS رایگان (Let's Encrypt) همیشه از بیرون به ۸۰ و ۴۴۳ می‌خورد.
# اگر عوض کردی، یا باید پورت‌های ۸۰/۴۴۳ بیرونی را روی این‌ها فوروارد کنی، یا پشت یک پروکسی دیگر بروی (پایین).
HTTP_PORT=80
HTTPS_PORT=443
# اگر HTTPS_PORT استاندارد نیست، آدرس عمومی مینی‌اپ را با پورت بنویس (وگرنه خالی بگذار):
# WEBAPP_URL=https://flix.example.com:8443
#
# حالت «پشت nginx/پروکسی دیگر»: خودِ پروکسی TLS را انجام می‌دهد و به HTTP_PORT فوروارد می‌کند.
# SITE_ADDRESS=http://flix.example.com
# HTTP_PORT=8081
# WEBAPP_URL=https://flix.example.com

# توکن ربات از BotFather
BOT_TOKEN=

# یک رشتهٔ تصادفی بلند (حداقل ۳۲ کاراکتر):  openssl rand -base64 48
JWT_KEY=

# کلید TMDB (اختیاری)
TMDB_API_KEY=

# اگر سرور مستقیم به api.telegram.org دسترسی ندارد، آدرس پروکسی/آینه (اختیاری)
# TELEGRAM_API_BASE=https://tg-proxy.example.com

# منطقهٔ زمانی سرور
TZ=Asia/Tehran

# --- فقط برای CI/CD و کشیدن ایمیج از GHCR (نام کاربری/سازمان گیت‌هاب، حروف کوچک) ---
GHCR_OWNER=
TAG=latest
